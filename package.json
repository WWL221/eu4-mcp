{
  "name": "eu4-mcp",
  "version": "0.1.1",
  "description": "MCP server that lets an AI co-play Europa Universalis IV: read savegame state and act on an AI-run nation via a companion mod bridge",
  "type": "module",
  "bin": {
    "eu4-mcp": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "probe": "node probe.js",
    "test": "node test.js",
    "smoke": "node smoke-mcp.js"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "europa-universalis",
    "eu4",
    "paradox",
    "ai-agent",
    "game"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "adm-zip": "^0.5.16",
    "jomini": "^0.5.0",
    "zod": "^4.6.7"
  }
}
